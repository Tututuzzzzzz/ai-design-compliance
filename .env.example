# Copy to .env and fill in one provider key.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Vision provider — pick ONE: anthropic | gemini | ollama
# ---------------------------------------------------------------------------
VISION_PROVIDER=anthropic

# Claude (default). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Gemini. Get a key at https://aistudio.google.com/apikey
# Also enables Google Drive folder import when the Drive API is enabled on the key.
# Check what your key can reach:  docker compose exec api python -m data.check_models
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Fully offline fallback via Ollama (`ollama pull llama3.2-vision`).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision

# Models tried in order when the primary is overloaded (503) or rate-limited (429).
# Free tiers return these constantly; without a fallback a busy provider turns a
# clean design into a RISKY 'analysis failed' row.
# Must be models of the provider selected above — the fallback chain uses the
# same provider client, so a gemini name with VISION_PROVIDER=anthropic errors out.
VISION_FALLBACK_MODELS=claude-sonnet-5,claude-haiku-4-5
VISION_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Trademark sources
# ---------------------------------------------------------------------------
# Public USPTO trademark search — the endpoint tmsearch.uspto.gov's own UI calls.
# NO API KEY, queries the current register, and it returns the Nice classes, which
# is what lets an off-class hit be reported as a lead instead of blocking a
# listing. This is the primary US register for that reason. It is a public
# interface but not a documented contract, so it is treated as best-effort like
# every other live register: set this to false if it ever starts refusing traffic.
USPTO_TMSEARCH_LOOKUP=true

# Keyed Open Data Portal endpoint, tried only after the keyless search above
# comes back empty. It returns no class data, so its hits cannot be checked
# against the goods — which is why it is the fallback and not the default.
USPTO_LIVE_LOOKUP=true

# USPTO Open Data Portal key (free, optional) — only needed for the fallback
# above. Register at https://data.uspto.gov/apis/getting-started
USPTO_API_KEY=

# EUIPO — the EU register. Only consulted when a design's markets include EU,
# because a US-only listing gains nothing from an EU hit. Credentials are free:
#   1. sign up at https://dev.euipo.europa.eu
#   2. create an app, subscribe it to the Trademark Search API
#   3. paste the Client ID ("API Key" in their UI) and Client Secret below
# Without both values the EU check is skipped and /api/health reports it as off.
EUIPO_LIVE_LOOKUP=true
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=

# Override only if EUIPO moves the gateway (a 404 on lookups is the symptom) or
# to point at the sandbox: https://dev-sandbox.euipo.europa.eu
# EUIPO_API_BASE=https://api.euipo.europa.eu/trademark-search
# EUIPO_TOKEN_URL=https://euipo.europa.eu/cas-server-webapp/oidc/accessToken

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
MAX_UPLOAD_MB=60
RENDER_MAX_EDGE=1600

# Cắt bỏ viền trong suốt để artwork nhỏ không bị thu nhỏ theo tỉ lệ canvas.
# TẮT mặc định vì đã đo: crop làm chữ to hơn ~3x, nhưng A/B trên design thật
# (data/ab_crop.py) cho 6/12 phát hiện khi tắt vs 5/12 khi bật — và một design
# chỉ-có-logo tụt từ 6/6 xuống 0/6 vì crop sát biến logo thành "logo asset",
# model mất ngữ cảnh "đây là design đang bán". Bật thì đo lại trước, đừng đoán.
AUTOCROP_TRANSPARENT=false
